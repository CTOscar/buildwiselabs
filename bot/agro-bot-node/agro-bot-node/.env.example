# Copia este archivo a ".env" y llena tus valores reales. Nunca subas el ".env" real a git.

# --- Servidor ---
PORT=3000
# Zona horaria para el resumen diario (IANA tz name)
TIMEZONE=America/Mazatlan
# Hora del resumen diario en formato cron (por defecto 8:00 PM todos los dias)
RESUMEN_CRON=0 20 * * *
# Hora del resumen semanal (por defecto domingo 8:00 PM; el "0" al final es domingo)
RESUMEN_SEMANAL_CRON=0 20 * * 0

# --- Gemini ---
# Genera tu key en https://aistudio.google.com/apikey
# Si tu key empieza con "AQ." usa el header x-goog-api-key (ya viene asi en el codigo).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Claude (Anthropic) ---
# Alternativa a Gemini SOLO para clasificar/extraer texto (Claude no acepta audio nativo
# todavia, asi que el audio de WhatsApp siempre pasa por Gemini sin importar este valor).
# Genera tu key en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# "gemini" (por defecto) o "claude" -- que IA usa la clasificacion/extraccion de TEXTO.
TEXT_AI_PROVIDER=gemini

# --- Google Sheets (cuenta de servicio) ---
# 1) Crea una cuenta de servicio en Google Cloud Console, activa la API de Sheets.
# 2) Descarga el JSON de credenciales y copia aqui el email y la private key.
# 3) Comparte AMBAS hojas de calculo (Reporte de Campo y Actividades Diarias) con ese email, como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

SHEET_REPORTE_CAMPO_ID=1rledplnYjPDTT_OgLTyNaXvSQS7Cn43v
SHEET_REPORTE_CAMPO_TAB=Rendimiento Diario Jornal

SHEET_ACTIVIDADES_ID=1pfSx99JEkGRDC9sRLdu6CkYjeS-SczwjlVrpc9bqATA
SHEET_ACTIVIDADES_TAB=Actividades Diarias

# Maquinaria e Insumos van en pestañas nuevas DENTRO del mismo archivo de Reporte de Campo
# (SHEET_REPORTE_CAMPO_ID de arriba), asi que solo hace falta el nombre de la pestaña.
SHEET_MAQUINARIA_TAB=Maquinaria
SHEET_INSUMOS_TAB=Insumos

# --- Gmail (envio del resumen y alertas de incidencia) ---
# Forma mas simple para un prototipo: activa verificacion en 2 pasos en la cuenta de Gmail
# y genera una "contrasena de aplicacion" en https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
CORREO_DESTINO=fernandovilla200215@gmail.com

# --- WhatsApp / Meta Graph API ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=agroPYME2026secreto
WHATSAPP_GRAPH_VERSION=v20.0
# phone_number_id y numero destino para el resumen diario por WhatsApp (opcional)
WHATSAPP_RESUMEN_PHONE_NUMBER_ID=
WHATSAPP_RESUMEN_NUMERO_DESTINO=

# --- Base de datos: PostgreSQL (OPCIONAL) ---
# Sin esto, el bot usa el login unico compartido de arriba (APP_LOGIN_USER/PASSWORD) y
# todo funciona como siempre. Con esto, cada persona tiene su cuenta, su nombre y su rol
# (ver la pantalla /usuarios, solo para administradores).
#
#   1) docker compose up -d            -> levanta Postgres (ver docker-compose.yml)
#   2) descomenta la linea de abajo
#   3) npm install && npx prisma generate && npm run db:migrate
#   4) npm run db:seed-admin -- "Tu Nombre" tu_usuario tu_password_segura
#
# DATABASE_URL="postgresql://agrobot:agrobot@localhost:5432/agrobot?schema=public"

# --- Modo mantenimiento (OPCIONAL) ---
# Normalmente NO se tocan: el interruptor vive en la pantalla /monitoreo, y un
# administrador lo enciende y apaga desde ahi.
#
# MANTENIMIENTO=1 deja la app cerrada a la fuerza y BLOQUEA el boton de la pantalla
# (freno de mano: solo se quita editando esto y reiniciando).
# MANTENIMIENTO=0
#
# Donde se guarda el estado del interruptor. Por defecto es "estado/mantenimiento.json"
# dentro del proyecto. En un hosting donde cada despliegue reemplaza la carpeta del
# codigo, apunta esto a una ruta que SI persista, o el mantenimiento se apagara solo
# en el siguiente despliegue.
# MANTENIMIENTO_ARCHIVO=/ruta/persistente/mantenimiento.json

# Copia este archivo como .env y ajusta los valores.

# true  = datos simulados (no necesita servidor). Úsalo mientras no exista el backend.
# false = conecta al servidor Traccar real.
VITE_USE_MOCK=true

# URL pública de Traccar SOLO si el front se sirve desde otro dominio.
# Déjalo vacío para usar el mismo dominio (o el proxy de Vite en desarrollo).
# Si es otro dominio, el servidor necesita web.origin en traccar.xml (CORS).
VITE_TRACCAR_URL=

# Solo desarrollo: a dónde reenvía el proxy de Vite las llamadas /api.
TRACCAR_PROXY_TARGET=http://localhost:8082
